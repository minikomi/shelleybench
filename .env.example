# Apply these through your shell or service environment; no automatic .env loader.
SHELLEY_BENCH_SHELLEY_BINARY=shelley
SHELLEY_BENCH_SHELLEY_REPO=/path/to/shelley
SHELLEY_BENCH_BASELINE_REF=main
SHELLEY_BENCH_ASSISTANT_MODEL=your-supported-model
# Optional toolchain roots; otherwise discovered from PATH.
# SHELLEY_BENCH_NODE_ROOT=/path/to/node-installation
# SHELLEY_BENCH_GO_ROOT=/path/to/go-installation
# Optional operator-maintained runtime profile, never a bundled personal profile.
# SHELLEY_BENCH_RUNTIME_PROFILE_DIR=/path/to/runtime-profile
